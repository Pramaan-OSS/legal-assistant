# Required: paste your Pramaan key, then run ./start. Everything else is automatic.
PRAMAAN_API_KEY=

# Optional: uncomment only to override the local defaults.
# PRAMAAN_BASE_URL=
# PRAMAAN_STORAGE_BUCKET=
# FRONTEND_URL=
# API_PUBLIC_URL=
# MAIL_FROM="Legal Assistant <noreply@updates.pramaan.one>"
# SUPPORT_EMAIL=
# SOCIAL_SIGN_IN_URL=
# SOCIAL_PROVIDER_KEY=
# WORD_ADDIN_URL=
# SEND_EMAIL_VIA_PRAMAAN=
# PRAMAAN_FAKE=
# APP_URL=
# LOCAL_SIGN_IN=
# ALLOWED_SIGN_IN=

# Optional managed password recovery: private SMTP settings on your verified sending domain.
# Never use a Pramaan domain. Recovery is not yet live-verified.
# MANAGED_RECOVERY_SENDER_EMAIL=accounts@example.com
# MANAGED_RECOVERY_SMTP_HOST=smtp.example.com
# MANAGED_RECOVERY_SMTP_PORT=587
# MANAGED_RECOVERY_SMTP_USERNAME=
# MANAGED_RECOVERY_SMTP_PASSWORD=
