        "../frontend/src/shared/ui/LegalAssistantIconUI.tsx"
      ],
      "@legal-assistant/google-icon-ui": [
        "../frontend/src/shared/ui/GoogleIconUI.tsx"
      ],
      "@legal-assistant/auth-styles-ui": [
        "../frontend/src/shared/ui/AuthStylesUI.ts"
      ],
      "@legal-assistant/auth-divider-ui": [
        "../frontend/src/shared/ui/AuthDividerUI.tsx"
      ],
      "@legal-assistant/workflow-slash-command-ui": [
        "../frontend/src/shared/ui/WorkflowSlashCommandUI.tsx"
