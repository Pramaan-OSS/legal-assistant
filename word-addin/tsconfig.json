      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "node",
      "office-js",
      "office-runtime",
      "react",
      "react-dom"
    ],
    "paths": {
