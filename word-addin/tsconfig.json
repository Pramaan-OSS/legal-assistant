        "../frontend/src/shared/lib/secureUuid.ts"
      ],
      "@legal-assistant/toast-store": [
        "../frontend/src/shared/lib/toastStore.ts"
      ],
      "@legal-assistant/toast-ui": [
        "../frontend/src/shared/ui/ToastUI.tsx"
      ],
      "@legal-assistant/user-error": [
        "../frontend/src/shared/lib/userError.ts"
      ],
      "@legal-assistant/model-catalog": [
        "../frontend/src/shared/lib/modelCatalog.ts"
      ],
      "@legal-assistant/message-excerpts": [
        "../frontend/src/shared/lib/messageExcerpts.ts"
      ],
      "@legal-assistant/response-selection-menu-ui": [
        "../frontend/src/shared/ui/ResponseSelectionMenuUI.tsx"
      ],
      "@legal-assistant/excerpt-pill-ui": [
