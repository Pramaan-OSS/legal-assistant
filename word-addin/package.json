{
  "name": "legal-assistant-word-addin",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "webpack serve --mode development",
    "dev:server": "webpack serve --mode development",
    "typecheck": "npm run typecheck:app && npm run typecheck:e2e",
    "typecheck:app": "tsc --noEmit -p tsconfig.json",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "build": "npm run typecheck && webpack --mode production && node scripts/build-manifest.js",
    "start": "npm run dev:server",
    "start:production": "node server.mjs",
    "test:server": "node --test server.test.mjs",
    "build:e2e": "npm run typecheck && REACT_APP_API_BASE_URL=/api REACT_APP_WEB_APP_URL=http://localhost:3000 webpack --mode production",
    "build:e2e:development": "npm run typecheck && REACT_APP_API_BASE_URL=/api REACT_APP_WEB_APP_URL=http://localhost:3000 webpack --mode development",
    "serve:e2e": "http-server dist -p 3100 -a 127.0.0.1 -c-1 --silent",
    "test:e2e": "playwright test",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "live:login": "node e2e-live/word-web-session.mjs --login",
    "live:word": "node e2e-live/manual-session.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "better-auth": "^1.7.10",
    "clsx": "^2.1.1",
    "lucide-react": "^1.51.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tiptap-markdown": "^0.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^26.6.4",
    "@types/office-js": "^1.0.611",
    "@types/office-runtime": "^1.0.40",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "css-loader": "^7.1.5",
    "html-webpack-plugin": "^5.6.8",
    "http-server": "^14.1.1",
    "office-addin-dev-certs": "^3.0.0",
    "postcss": "^8.5.28",
    "postcss-loader": "^8.2.0",
    "semver": "^7.8.5",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.1.18",
    "ts-loader": "^9.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.12",
    "adm-zip": "^0.6.1",
    "compression": "1.8.2",
    "js-yaml": "^4.3.2",
    "proxy-addr": "2.0.8",
    "qs": "^6.15.4",
    "source-map-js": "1.2.2"
  }
}
